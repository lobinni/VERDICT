# Optional — durable PostgreSQL for the indexer mirror. When unset, the app
# runs zero-config with an in-memory store (no database required to deploy on
# Vercel; the intelligent contract remains the canonical on-chain record).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public GenLayer Bradbury network parameters (browser-exposed).
# Chain id: fill from the official network configuration when adding the
# network to MetaMask — it is intentionally not hard-coded or guessed.
NEXT_PUBLIC_GL_CHAIN_ID=
NEXT_PUBLIC_GL_RPC_URL=https://rpc-bradbury.genlayer.com
NEXT_PUBLIC_GL_EXPLORER_URL=https://explorer-bradbury.genlayer.com

# Deployed Verdict Intelligent Contract on Bradbury (docs/contract.md).
# Replace with your own address after deploying contracts/Verdict.py from GenLayer Studio.
NEXT_PUBLIC_GL_CONTRACT_ADDRESS=0x5056ad2dFf0a132c42806c2efaEb206743186E0b
